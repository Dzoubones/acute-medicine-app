{
  "name": "acute-medical-take-mobile",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "ios:add": "CAPACITOR_PLATFORM=ios cap add ios --packagemanager SPM",
    "ios:sync": "npm run build && CAPACITOR_PLATFORM=ios cap sync ios",
    "ios:open": "npm run ios:sync && CAPACITOR_PLATFORM=ios cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
