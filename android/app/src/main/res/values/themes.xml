<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AcuteMedicalTake" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@color/amt_navy</item>
        <item name="android:navigationBarColor">@color/amt_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/amt_navy</item>
    </style>

    <style name="Theme.AcuteMedicalTake.Starting" parent="Theme.AcuteMedicalTake">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
